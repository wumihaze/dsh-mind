{
  "name": "@wumihaze/dsh-mind",
  "description": "Give your DSH agent a mind: persistent memory + self-curating skills",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./memory/nudge": {
      "types": "./lib/types/memory/nudge.d.ts",
      "default": "./lib/memory/nudge.js"
    },
    "./memory/guidance": {
      "types": "./lib/types/memory/guidance.d.ts",
      "default": "./lib/memory/guidance.js"
    },
    "./skill-usage": {
      "types": "./lib/types/skill-usage/index.d.ts",
      "default": "./lib/skill-usage/index.js"
    },
    "./curator": {
      "types": "./lib/types/curator/index.d.ts",
      "default": "./lib/curator/index.js"
    },
    "./tool/skill-manage": {
      "types": "./lib/types/tool/skill-manage.d.ts",
      "default": "./lib/tool/skill-manage.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "presets/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "latest",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wumihaze/dsh-mind.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
