{
  "name": "@wumihaze/dsh-mind",
  "description": "Give your DSH agent a mind: persistent memory + self-curating skills",
  "version": "0.1.10",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-mind": "./lib/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./memory/nudge": {
      "types": "./lib/types/memory/nudge.d.ts",
      "default": "./lib/memory/nudge.js"
    },
    "./memory/guidance": {
      "types": "./lib/types/memory/guidance.d.ts",
      "default": "./lib/memory/guidance.js"
    },
    "./skill-usage": {
      "types": "./lib/types/skill-usage/index.d.ts",
      "default": "./lib/skill-usage/index.js"
    },
    "./curator": {
      "types": "./lib/types/curator/index.d.ts",
      "default": "./lib/curator/index.js"
    },
    "./tool/skill-manage": {
      "types": "./lib/types/tool/skill-manage.d.ts",
      "default": "./lib/tool/skill-manage.js"
    },
    "./web": {
      "types": "./lib/types/web.d.ts",
      "default": "./lib/web.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "client/",
    "cordis.patch.yml",
    "presets/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:host": "tsc -p tsconfig.json",
    "build:client": "tsdown",
    "test": "node tests/integration.mjs",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true}); try{require('fs').rmSync('client',{recursive:true,force:true})}catch{}\"",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "0.1.1-rc.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.26.0",
    "react": "^18.3.1",
    "tsdown": "^0.11.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wumihaze/dsh-mind.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
